{
  "name": "aathma-player",
  "version": "1.0.0",
  "description": "Aathma Player - Dark cinematic music player with lyrics sync",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder -wml",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.aathma.player",
    "productName": "Aathma Player",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/",
      "!node_modules/",
      "!*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Aathma-Player-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "artifactName": "Aathma-Player-macOS.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "artifactName": "Aathma-Player-Linux.${ext}"
    },
    "portable": {
      "artifactName": "Aathma-Player-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Aathma Player",
      "artifactName": "Aathma-Player-Setup.${ext}"
    }
  },
  "devDependencies": {
    "app-builder-bin": "^4.2.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9"
  },
  "author": "Pranav Sharma",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.10.0"
  }
}
